# ==============================================================================
# OmniMind AI — Variables d'environnement & Configuration
# Copiez ce fichier vers .env.local pour configurer votre environnement :
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL & RAG Vectoriel (Prisma + pgvector)
# ------------------------------------------------------------------------------
# Compatible Supabase, Neon, AWS RDS, ou Docker local avec pgvector.
# Pour Docker local :
#   docker run --name omnimind-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d pgvector/pgvector:pg16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnimind?schema=public"

# ------------------------------------------------------------------------------
# 2. Cerveau IA & Transcription Vocale (au moins une clé recommandée)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, Whisper & text-embedding-3-small 1536d)
OPENAI_API_KEY=""

# Google Gemini (Gemini 2.0 Flash)
GEMINI_API_KEY=""

# Groq (Llama 3.3 70B & Whisper Turbo - ultra-rapide)
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Canaux de Communication Omnicanale
# ------------------------------------------------------------------------------
# Telegram Bot API
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# WhatsApp Business Cloud API (Meta Graph)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="omnimind_secret_verify_token"
WHATSAPP_USER_PHONE=""

# Discord Webhook
DISCORD_WEBHOOK_URL=""

# Google Workspace / Gmail & Google Calendar
GOOGLE_ACCESS_TOKEN=""

# Microsoft 365 / Outlook
MICROSOFT_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Authentification & Emails Transactionnels (Magic Link)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="OmniMind <onboarding@resend.dev>"

# Sécurité des tâches Cron et API
CRON_SECRET="omnimind_cron_secure_secret_token"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# 5. MODULE DE VOIX — MOTEUR VOCAL HUMAIN (TTS + STT + personnalités)
# =============================================================================
# ElevenLabs — Meilleure naturalité vocale, expressivité et clonage
# Créer une clé : https://elevenlabs.io
ELEVENLABS_API_KEY=""
# Voix française par défaut. "Freya" existe sur la plupart des comptes.
# Liste des voix : GET https://api.elevenlabs.io/v1/voices (header: Xi-Api-Key)
ELEVENLABS_VOICE_ID="Freya"

# OpenAI TTS — Stable et rapide. Réutilise la même clé que pour les LLM.
# Voix disponibles : alloy | echo | fable | nova | onyx | shimmer
OPENAI_TTS_VOICE="nova"

# Google Cloud Text-to-Speech (optionnel)
GOOGLE_TTS_API_KEY=""

# Cache audio local (optionnel) — Évite de re-générer les mêmes phrases.
VOICE_CACHE_DIR=".data/voice-cache"
